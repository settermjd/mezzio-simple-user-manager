<h1>Forgot Your Password?</h1>

<form method="post"
      enctype="application/x-www-form-urlencoded"
      name="forgot-form"
      action="/forgot-password">

    <div>
        <label for="identity">Username/Email Address:</label>
        <input type="text" id="identity" name="email">
    </div>

    <input type="submit" name="submit" value="Reset Your Password">
    <input type="hidden" name="__csrf" value="{{ csrf_token }}">

</form>

<div class="bottom-notice">
    <a href="/login">Sign in</a>.
</div>
